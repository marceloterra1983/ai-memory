+    }
+
+    /// Typed scope absence is `data.code = scope_not_found` on the existing
+    /// invalid-params error. Malformed input keeps `data` empty. Forbidden
+    /// and store failures stay internal and are not absence.
+    #[test]
+    fn scope_error_marks_not_found_without_changing_the_message() {
+        use ai_memory_store::ScopeResolutionError;
+
+        let missing = ScopeResolutionError::ProjectNotFoundInWorkspace {
+            workspace: "default".into(),
+            project: "caminhar".into(),
+        };
+        let err = AiMemoryServer::scope_error(missing);
+        assert_eq!(err.code, rmcp::model::ErrorCode::INVALID_PARAMS);
+        assert_eq!(
+            err.message,
+            "project 'caminhar' not found in workspace 'default'"
+        );
+        assert_eq!(
+            err.data,
+            Some(serde_json::json!({"code": "scope_not_found"}))
+        );
+
+        let malformed = AiMemoryServer::scope_error(ScopeResolutionError::ScopeProjectEmpty);
+        assert_eq!(malformed.code, rmcp::model::ErrorCode::INVALID_PARAMS);
+        assert!(malformed.data.is_none());
+
+        let forbidden = AiMemoryServer::scope_error(ScopeResolutionError::Forbidden(
+            "restricted project".into(),
+        ));
+        assert_eq!(forbidden.code, rmcp::model::ErrorCode::INTERNAL_ERROR);
+        assert!(forbidden.data.is_none());
