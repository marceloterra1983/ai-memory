--- a/install-ai-memory.sh	2026-10-09 23:01:58.866728590 -0300
+++ b/install-ai-memory.sh	2026-10-09 23:01:58.866771141 -0300
@@ -153,11 +153,17 @@
 systemctl --user enable --now ai-memory.service
 have loginctl && loginctl enable-linger "$USER" >/dev/null 2>&1 || true
 ready=0
-for _ in $(seq 1 20); do
-  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "$SERVER_ORIGIN/handoff" || true)"
