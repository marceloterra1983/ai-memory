[Unit]
Description=ai-memory native hooks with scoped persistence receipts
After=ai-memory-ingress.service

[Service]
Type=simple
Environment=PYTHONPATH=%h/.agents/tools/ai-memory/reliable-mcp
ExecStart=/usr/bin/python3 -B -m reliable_mcp.hook_delivery --spool %h/.local/share/ai-memory/hook-spool --database %h/.local/share/ai-memory/db/memory.sqlite --archive %h/backups/ai-memory/hooks-delivered --origin http://127.0.0.1:49374
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
